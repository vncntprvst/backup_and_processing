# Python
__pycache__/
*.pyc

# Secrets / credentials — never commit
.env
*token*.txt
*access*.txt
*.key
# SyncBackPro profiles may embed server credentials — commit only a credential-free
# template, never a profile saved with real passwords/hosts.
# (data_sync.sps in this repo is a credential-free template.)

# Logs / runtime
*.log
log.txt

# OS
.DS_Store
Thumbs.db
